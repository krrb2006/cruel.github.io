---
import SiteLayout from "../layouts/SiteLayout.astro";
import { site } from "../data/site";

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const quoteImage = `${base}${site.background}`;

const focuses = [
  { number: "01", title: "前端开发", text: "从 HTML、CSS 到 Astro，把想法变成能打开、能分享的作品。" },
  { number: "02", title: "视觉表达", text: "练习留白、排版和配色，让页面不仅可用，也有自己的气质。" },
  { number: "03", title: "持续记录", text: "写下真实的踩坑与进步，让每一次尝试都成为下一次出发的基础。" },
];
---

<SiteLayout title="首页" description={site.intro}>
  <style>
    .hero {
      display: grid;
      grid-template-columns: minmax(0, 1.16fr) minmax(340px, 0.84fr);
      gap: 18px;
      min-height: 640px;
    }

    .hero-copy {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: clamp(30px, 5vw, 64px);
      color: #fffefa;
      background: var(--forest-dark);
    }

    .hero-copy::after {
      position: absolute;
      right: -90px;
      bottom: -120px;
      width: 330px;
      height: 330px;
      content: "";
      border: 1px solid rgba(217, 240, 107, 0.35);
      border-radius: 50%;
      box-shadow:
        0 0 0 48px rgba(217, 240, 107, 0.05),
        0 0 0 96px rgba(217, 240, 107, 0.03);
    }

    .hero-copy .eyebrow { color: #e9f3c3; }

    .hero-copy .eyebrow::before {
      background: var(--lime);
      box-shadow: 0 0 0 5px rgba(217, 240, 107, 0.13);
    }

    .hero-title {
      max-width: 760px;
      margin: 54px 0 22px;
      font-size: clamp(62px, 9vw, 126px);
      font-weight: 820;
      line-height: 0.88;
      letter-spacing: -0.075em;
    }

    .hero-title em {
      color: var(--lime);
      font-family: Georgia, "Times New Roman", serif;
      font-weight: 400;
    }

    .hero-desc {
      max-width: 610px;
      margin: 0;
      color: rgba(255, 254, 250, 0.72);
      font-size: clamp(16px, 1.8vw, 19px);
      line-height: 1.9;
    }

    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 32px;
    }

    .hero-copy .btn-primary {
      color: var(--forest-dark);
      background: var(--lime);
      box-shadow: none;
    }

    .hero-copy .btn-primary:hover { background: #e4f58e; }

    .hero-copy .btn-secondary {
      color: #fffefa;
      border-color: rgba(255, 255, 255, 0.22);
      background: rgba(255, 255, 255, 0.06);
    }

    .hero-foot {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      margin-top: 54px;
      padding-top: 20px;
      color: rgba(255, 254, 250, 0.62);
      border-top: 1px solid rgba(255, 255, 255, 0.13);
      font-size: 12px;
      font-weight: 720;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .hero-visual {
      display: flex;
      flex-direction: column;
      min-height: 520px;
      padding: 14px;
      background: #dfe6dc;
    }

    .visual-image {
      position: relative;
      flex: 1;
      min-height: 390px;
      overflow: hidden;
      border-radius: 20px;
      background: #edf0eb;
    }

    .visual-image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      filter: saturate(0.72) contrast(1.02);
      transform: scale(1.025);
    }

    .visual-label {
      position: absolute;
      top: 16px;
      left: 16px;
      padding: 8px 11px;
      color: #fff;
      border: 1px solid rgba(255, 255, 255, 0.24);
      border-radius: 999px;
      background: rgba(23, 51, 36, 0.78);
      backdrop-filter: blur(10px);
      font-size: 11px;
      font-weight: 760;
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }

    .visual-bottom {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 18px;
      align-items: end;
      padding: 24px 10px 12px;
    }

    .visual-quote {
      max-width: 310px;
      font-family: Georgia, "Times New Roman", "Songti SC", serif;
      font-size: 24px;
      line-height: 1.35;
      letter-spacing: -0.02em;
    }

    .visual-index {
      color: var(--forest);
      font-family: Georgia, serif;
      font-size: 64px;
      line-height: 0.8;
      opacity: 0.23;
    }

    .intro-strip {
      display: grid;
      grid-template-columns: 0.72fr 1.28fr;
      gap: 48px;
      align-items: start;
      margin: 96px 0;
      padding: 0 clamp(8px, 3vw, 34px);
    }

    .intro-strip h2 {
      margin: 0;
      font-size: clamp(34px, 5vw, 58px);
      line-height: 1.05;
      letter-spacing: -0.055em;
    }

    .intro-copy {
      max-width: 680px;
      margin: 0;
      color: var(--muted);
      font-size: clamp(18px, 2vw, 24px);
      line-height: 1.75;
    }

    .intro-copy strong { color: var(--forest-dark); font-weight: 780; }

    .section-head {
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 30px;
      margin-bottom: 24px;
    }

    .section-head p {
      max-width: 470px;
      margin: 0;
      color: var(--muted);
    }

    .focus-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      background: rgba(255, 254, 250, 0.56);
      box-shadow: var(--shadow);
    }

    .focus-card {
      min-height: 300px;
      padding: 28px;
      border-right: 1px solid var(--line);
      transition: color 0.25s ease, background 0.25s ease;
    }

    .focus-card:last-child { border-right: 0; }

    .focus-card:hover {
      color: #fffefa;
      background: var(--forest-dark);
    }

    .focus-number {
      display: block;
      margin-bottom: 92px;
      color: var(--orange);
      font-family: Georgia, serif;
      font-size: 16px;
      font-style: italic;
    }

    .focus-card h3 { margin: 0 0 12px; font-size: 25px; letter-spacing: -0.03em; }
    .focus-card p { margin: 0; color: var(--muted); line-height: 1.8; }
    .focus-card:hover p { color: rgba(255, 254, 250, 0.68); }

    .journal {
      display: grid;
      grid-template-columns: 0.92fr 1.08fr;
      gap: 18px;
      margin-top: 92px;
    }

    .journal-title {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      min-height: 420px;
      padding: 38px;
      color: #fffefa;
      background: var(--forest-dark);
    }

    .journal-title h2 {
      max-width: 420px;
      margin: 18px 0 0;
      font-size: clamp(45px, 6vw, 72px);
      line-height: 0.98;
      letter-spacing: -0.06em;
    }

    .journal-title small { color: rgba(255, 254, 250, 0.58); }

    .post-card {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      min-height: 420px;
      padding: 38px;
    }

    .post-meta {
      display: flex;
      justify-content: space-between;
      gap: 18px;
      color: var(--muted);
      font-size: 12px;
      font-weight: 760;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .post-card h3 {
      max-width: 580px;
      margin: 38px 0 16px;
      font-size: clamp(36px, 5vw, 58px);
      line-height: 1.03;
      letter-spacing: -0.055em;
    }

    .post-card p { max-width: 610px; margin: 0; color: var(--muted); line-height: 1.9; }

    .post-link {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      margin-top: 34px;
      color: var(--forest-dark);
      font-weight: 820;
    }

    .post-link span {
      display: grid;
      width: 36px;
      height: 36px;
      place-items: center;
      color: #fffefa;
      border-radius: 50%;
      background: var(--forest-dark);
      transition: transform 0.2s ease;
    }

    .post-link:hover span { transform: translateX(4px); }

    .contact-banner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 30px;
      margin-top: 18px;
      padding: 28px 34px;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      background: var(--lime);
    }

    .contact-banner strong { font-size: clamp(21px, 3vw, 32px); letter-spacing: -0.03em; }
    .contact-banner a { padding-bottom: 3px; border-bottom: 1px solid currentColor; font-weight: 800; }

    @media (max-width: 940px) {
      .hero, .journal { grid-template-columns: 1fr; }
      .hero-copy { min-height: 580px; }
      .hero-visual { min-height: 540px; }
      .intro-strip { grid-template-columns: 1fr; gap: 24px; }
      .focus-grid { grid-template-columns: 1fr; }
      .focus-card { min-height: auto; border-right: 0; border-bottom: 1px solid var(--line); }
      .focus-card:last-child { border-bottom: 0; }
      .focus-number { margin-bottom: 44px; }
    }

    @media (max-width: 600px) {
      .hero { min-height: auto; }
      .hero-copy { min-height: 560px; padding: 28px 24px; }
      .hero-title { margin-top: 42px; font-size: clamp(60px, 22vw, 86px); }
      .hero-actions .btn { width: 100%; }
      .hero-foot { align-items: flex-start; flex-direction: column; }
      .hero-visual { min-height: 460px; }
      .visual-image { min-height: 320px; }
      .visual-quote { font-size: 20px; }
      .intro-strip { margin: 72px 0; padding: 0 8px; }
      .section-head { align-items: flex-start; flex-direction: column; }
      .journal { margin-top: 72px; }
      .journal-title, .post-card { min-height: 360px; padding: 28px 24px; }
      .contact-banner { align-items: flex-start; flex-direction: column; padding: 26px 24px; }
    }
  </style>

  <section class="hero" aria-labelledby="hero-title">
    <article class="panel hero-copy">
      <div>
        <span class="eyebrow">Hello, I’m {site.nickname}</span>
        <h1 id="hero-title" class="hero-title">写代码，<br />也写下<em>成长。</em></h1>
        <p class="hero-desc">
          我正在学习前端开发与网页设计。这里是我的数字花园，记录代码、审美、踩坑，以及一个想法如何慢慢变成作品。
        </p>
        <div class="hero-actions">
          <a class="btn btn-primary" href={`${base}posts/first-post/`}>开始阅读 <span aria-hidden="true">↗</span></a>
          <a class="btn btn-secondary" href={`${base}about/`}>认识我</a>
        </div>
      </div>

      <div class="hero-foot">
        <span>Based in China</span>
        <span>{site.status}</span>
      </div>
    </article>

    <aside class="panel hero-visual" aria-label="个人信念">
      <div class="visual-image">
        <img src={quoteImage} alt="幸运的傻子会走到终点，就像傻子一样地往前走" />
        <span class="visual-label">Keep moving forward</span>
      </div>
      <div class="visual-bottom">
        <div class="visual-quote">“先向前走，答案会在路上慢慢出现。”</div>
        <span class="visual-index" aria-hidden="true">01</span>
      </div>
    </aside>
  </section>

  <section class="intro-strip" aria-labelledby="intro-title">
    <h2 id="intro-title">不只把页面<br />做出来。</h2>
    <p class="intro-copy">
      我更想理解一个页面为什么好看、为什么好用，以及它如何准确地表达一个人。
      现在的我仍在路上，但我相信：<strong>持续做、持续复盘，作品会替你说话。</strong>
    </p>
  </section>

  <section aria-labelledby="focus-title">
    <div class="section-head">
      <div>
        <span class="eyebrow">What I’m exploring</span>
        <h2 id="focus-title" class="section-title">现在，专注这三件事</h2>
      </div>
      <p>学习不必假装无所不知。把当前方向说清楚，然后用作品一步步兑现。</p>
    </div>

    <div class="focus-grid">
      {focuses.map((item) => (
        <article class="focus-card">
          <span class="focus-number">{item.number}</span>
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="journal" aria-labelledby="journal-title">
    <div class="panel journal-title">
      <div>
        <span class="eyebrow">From the journal</span>
        <h2 id="journal-title">最近<br />写下的事</h2>
      </div>
      <small>关于建站、学习与正在发生的改变</small>
    </div>

    <article class="panel post-card">
      <div class="post-meta">
        <span>建站记录</span>
        <time datetime="2026-04-03">2026.04.03</time>
      </div>
      <div>
        <h3>我的第一篇博客</h3>
        <p>从 0 开始，把博客真正搭上线。这篇文章记录了一个朴素但重要的瞬间：从“我想做”，走到了“我做出来了”。</p>
        <a class="post-link" href={`${base}posts/first-post/`}>阅读全文 <span aria-hidden="true">→</span></a>
      </div>
    </article>
  </section>

  <aside class="contact-banner">
    <strong>有想法想聊聊？欢迎来找我。</strong>
    <a href={`mailto:${site.email}`}>{site.email} ↗</a>
  </aside>
</SiteLayout>
