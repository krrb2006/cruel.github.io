---
import SiteLayout from '../layouts/SiteLayout.astro';
import { site } from '../data/site';
import JournalFeed from '../components/JournalFeed.astro';
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
---

<SiteLayout title="首页" description="lkr 的私人手记。在文字与代码之间，收集日常的微光，记录缓慢而认真的成长。">
  <div class="edition"><span>A PERSONAL JOURNAL BY LKR</span><span>文字 / 日常 / 慢慢生长</span></div>
  <section class="opening" aria-labelledby="opening-title">
    <div class="opening-copy">
      <p class="overline">LET LIFE BLOOM, QUIETLY.</p>
      <h1 id="opening-title">把日子写成诗，<br />把自己还给<span>生活。</span></h1>
      <p class="opening-description">你好，我是 {site.nickname}。<br />在文字与代码之间，搭建一小块属于自己的天地。<br />记录学习，也收集平凡日子里值得停留的微光。</p>
      <a class="text-link" href="#journal">翻开我的手记 <span aria-hidden="true">↗</span></a>
      <div class="signature">with love, <i>lkr</i></div>
    </div>
    <figure class="opening-image">
      <img src={`${base}flowers.jpg`} alt="阳光下盛放的金黄色花朵" width="1100" height="1400" fetchpriority="high" />
      <figcaption><span>FIG. 01 — A LITTLE PIECE OF SPRING</span><i>愿你有自己的花期。</i></figcaption>
    </figure>
  </section>

  <section class="letter" aria-labelledby="letter-title">
    <p class="overline">A LETTER TO YOU</p>
    <h2 id="letter-title">如果你刚好路过，<br />就坐下来，读一会儿吧。</h2>
    <p>这里没有标准答案，只有一个正在生长的我。<br />把想法变成页面，把尝试写成文字，<br />也给那些暂时没有结果的事情，留一点时间。</p>
    <a class="text-link" href={`${base}about/`}>关于这位写信的人 <span aria-hidden="true">↗</span></a>
  </section>

  <section id="journal" class="journal-section" aria-labelledby="journal-title">
    <div class="section-heading"><div><p class="overline">THE JOURNAL</p><h2 id="journal-title">一些文字，一些生长。</h2></div><span class="section-note">写下此刻，留给以后。</span></div>
    <a class="essay" href={`${base}posts/first-post/`}>
      <div class="essay-image"><img src={`${base}journal.jpg`} alt="桌上的笔记本与手写记录" width="1000" height="670" loading="lazy" /></div>
      <div class="essay-copy"><div class="essay-meta"><span>01 / 建站手记</span><time datetime="2026-04-03">APR 03, 2026</time></div><h3>我的第一篇博客</h3><p>从“我想做点什么”，到“我真的做出来了”。<br />一个不太熟练、却认真开始的故事。</p><span class="text-link">读这篇手记 <span aria-hidden="true">↗</span></span></div>
    </a>
    <JournalFeed compact />
  </section>

  <section class="margins" aria-labelledby="margins-title">
    <div class="margin-intro"><p class="overline">IN THE MARGINS</p><h2 id="margins-title">在生活的<br /><i>留白里。</i></h2><p>允许自己缓慢，<br />也允许自己充满期待。</p></div>
    <div class="margin-note"><span class="note-number">I.</span><h3>学习，让想法有形状</h3><p>从 Git、Astro 到页面设计。每一次小小的完成，都让我更靠近心里想做的作品。</p><span class="note-label">CODE & CURIOSITY</span></div>
    <div class="margin-note"><span class="note-number">II.</span><h3>记录，让成长有回声</h3><p>有些过程值得被记住。那些摸索、改动和终于明白的瞬间，都会在这里留下痕迹。</p><span class="note-label">WORDS & GROWTH</span></div>
  </section>

  <section class="closing" aria-labelledby="closing-title"><p class="overline">UNTIL NEXT TIME</p><h2 id="closing-title">世界很大，<i>很高兴在这里遇见你。</i></h2><p>如果有一句话、一个想法想分享，欢迎写信给我。</p><a class="text-link" href={`mailto:${site.email}`}>给我一封来信 <span aria-hidden="true">↗</span></a></section>

  <style>
    .edition{display:flex;justify-content:space-between;border-bottom:1px solid var(--line);padding:8px 0 20px;font-size:10px;letter-spacing:.18em;color:var(--muted)}
    .opening{display:grid;grid-template-columns:1.15fr .85fr;gap:70px;align-items:center;padding:72px 0 80px}
    .overline{font-family:var(--sans);font-size:10px;letter-spacing:.22em;color:var(--rose);font-weight:600;margin:0 0 26px}
    h1,h2,h3{font-family:var(--serif);font-weight:400}
    h1{font-size:clamp(36px,4.4vw,62px);line-height:1.55;letter-spacing:.015em;margin:0 0 28px}
    h1 span{color:var(--rose)}
    .opening-description{color:var(--muted);font-size:14px;line-height:2.2;margin-bottom:30px}
    .text-link{display:inline-flex;align-items:center;gap:30px;border-bottom:1px solid var(--rose);padding:6px 0;color:var(--ink);font-size:12px;letter-spacing:.08em;transition:color .2s,gap .2s}
    .text-link:hover{color:var(--rose);gap:38px}
    .signature{margin-top:44px;color:var(--muted);font-family:Georgia,serif;font-style:italic;font-size:14px}.signature i{font-size:32px;margin-left:8px;color:var(--rose)}
    .opening-image{margin:0;position:relative}.opening-image:before{content:'';position:absolute;inset:22px -18px -18px 22px;border:1px solid #ded5c8;z-index:0}.opening-image img{position:relative;width:100%;height:500px;object-fit:cover;display:block;filter:saturate(.72)}
    figcaption{position:relative;display:flex;justify-content:space-between;gap:12px;padding-top:18px;font-size:8px;letter-spacing:.12em;color:var(--muted)}figcaption i{font-family:var(--serif);font-size:12px;letter-spacing:.04em}
    .letter{text-align:center;border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:80px 0;background:radial-gradient(ellipse at center,#ece4df66,transparent 65%)}
    .letter h2{font-size:32px;line-height:1.7;margin:0 0 24px}.letter p:not(.overline){font-size:14px;line-height:2.3;color:var(--muted);margin-bottom:24px}
    .journal-section{padding:85px 0;scroll-margin-top:100px}.section-heading{display:flex;justify-content:space-between;align-items:end;margin-bottom:35px}.section-heading .overline{margin-bottom:12px}.section-heading h2{font-size:32px;margin:0}.section-note{color:var(--muted);font-size:12px}
    .essay{display:grid;grid-template-columns:1fr 1fr;gap:54px;align-items:center}.essay-image{overflow:hidden}.essay-image img{display:block;width:100%;height:310px;object-fit:cover;filter:saturate(.5);transition:transform .6s}.essay:hover img{transform:scale(1.035)}.essay-meta{display:flex;justify-content:space-between;font-size:10px;letter-spacing:.12em;color:var(--muted)}.essay h3{font-size:36px;line-height:1.4;margin:28px 0 18px}.essay p{color:var(--muted);font-size:14px;line-height:2.1;margin-bottom:30px}
    .margins{display:grid;grid-template-columns:1fr 1fr 1fr;gap:44px;border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:60px 0}.margin-intro h2{font-size:38px;line-height:1.5;margin:0 0 18px}.margin-intro h2 i{color:var(--rose);font-style:normal}.margin-intro p:last-child{font-size:12px;color:var(--muted);line-height:2}.margin-note{padding:8px 0 0 28px;border-left:1px solid var(--line)}.note-number{font-family:Georgia,serif;font-style:italic;font-size:26px;color:var(--rose)}.margin-note h3{font-size:21px;margin:35px 0 18px}.margin-note p{font-size:13px;line-height:2.1;color:var(--muted)}.note-label{display:block;font-size:9px;letter-spacing:.17em;color:var(--rose);margin-top:32px}.closing{text-align:center;padding:80px 0 40px}.closing h2{font-size:30px;margin:0 0 20px}.closing h2 i{font-style:normal;color:var(--rose)}.closing p:not(.overline){font-size:13px;color:var(--muted);margin-bottom:25px}
    @media(max-width:900px){.opening{gap:35px}.opening-image img{height:420px}h1{font-size:40px}.essay{gap:30px}.margins{gap:22px}.margin-note{padding-left:20px}}
    @media(max-width:640px){.edition{font-size:8px;letter-spacing:.09em}.opening{grid-template-columns:1fr;padding:45px 0 55px;gap:35px}.opening-copy{padding:0 4px}h1{font-size:clamp(30px,7.8vw,43px)}.opening-image{margin-right:16px}.opening-image img{height:370px}.signature{margin-top:25px}.letter{padding:55px 12px}.letter h2{font-size:26px}.journal-section{padding:55px 0}.section-heading h2{font-size:27px}.section-note{display:none}.essay{grid-template-columns:1fr;gap:25px}.essay-image img{height:250px}.essay h3{font-size:30px;margin-top:20px}.margins{grid-template-columns:1fr;padding:45px 0;gap:30px}.margin-intro h2 br{display:none}.margin-intro h2{font-size:30px}.margin-note h3{margin-top:15px}.closing{padding:55px 10px 15px}.closing h2{font-size:25px;line-height:1.7}}
  </style>
</SiteLayout>
