---
import SiteLayout from "../layouts/SiteLayout.astro";
import { site } from "../data/site";

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const portrait = `${base}${site.avatar}`;

const timeline = [
  { year: "起点", title: "把网站发布出来", text: "从 Git 和部署开始，完成第一个真正在线的个人页面。" },
  { year: "现在", title: "让代码与审美一起进步", text: "学习 Astro、页面布局、响应式设计，也开始在意表达是否清晰。" },
  { year: "接下来", title: "用作品建立自己的坐标", text: "继续写、继续做，把这里变成一份长期、真实的成长档案。" },
];
---

<SiteLayout title="关于我" description="关于 lkr、正在学习的方向和这个博客">
  <style>
    .about-hero {
      display: grid;
      grid-template-columns: 1.12fr 0.88fr;
      gap: 18px;
    }

    .about-copy {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      min-height: 520px;
      padding: clamp(30px, 5vw, 58px);
      color: #fffefa;
      background: var(--forest-dark);
    }

    .about-copy .eyebrow { color: #e9f3c3; }
    .about-copy .eyebrow::before { background: var(--lime); box-shadow: 0 0 0 5px rgba(217,240,107,.13); }

    h1 {
      max-width: 740px;
      margin: 48px 0 22px;
      font-size: clamp(54px, 8vw, 100px);
      line-height: 0.95;
      letter-spacing: -0.07em;
    }

    h1 em { color: var(--lime); font-family: Georgia, serif; font-weight: 400; }

    .lead { max-width: 660px; margin: 0; color: rgba(255,254,250,.7); font-size: 18px; line-height: 1.9; }
    .about-sign { margin-top: 42px; color: rgba(255,254,250,.5); font-family: Georgia, serif; font-size: 14px; font-style: italic; }

    .quote-card {
      display: flex;
      flex-direction: column;
      padding: 14px;
      background: #e9e6dc;
    }

    .quote-card img {
      width: 100%;
      min-height: 340px;
      flex: 1;
      object-fit: cover;
      border-radius: 20px;
      filter: saturate(.75) contrast(1.02);
    }

    .quote-meta { padding: 22px 10px 10px; }
    .quote-meta strong { display: block; font-family: Georgia, "Songti SC", serif; font-size: 22px; }
    .quote-meta span { color: var(--muted); font-size: 13px; }

    .about-grid {
      display: grid;
      grid-template-columns: .8fr 1.2fr;
      gap: 70px;
      margin: 96px 0;
      padding: 0 clamp(8px, 3vw, 34px);
    }

    .about-aside { position: sticky; top: 114px; align-self: start; }
    .about-aside h2 { margin: 10px 0 18px; font-size: 42px; line-height: 1.08; letter-spacing: -.05em; }
    .about-aside p { color: var(--muted); line-height: 1.9; }

    .contact-list { display: grid; gap: 10px; margin-top: 26px; }
    .contact-list a, .contact-list span { padding: 13px 0; border-bottom: 1px solid var(--line); font-weight: 760; }
    .contact-list a:hover { color: var(--orange); }

    .story { display: grid; gap: 56px; }
    .story-block h3 { margin: 0 0 16px; font-size: clamp(28px, 4vw, 42px); line-height: 1.15; letter-spacing: -.045em; }
    .story-block p { margin: 0; color: var(--muted); font-size: 17px; line-height: 2; }

    .timeline { display: grid; margin-top: 26px; border-top: 1px solid var(--line); }
    .timeline-item { display: grid; grid-template-columns: 86px 1fr; gap: 24px; padding: 25px 0; border-bottom: 1px solid var(--line); }
    .timeline-year { color: var(--orange); font-family: Georgia, serif; font-style: italic; }
    .timeline-item h4 { margin: 0 0 7px; font-size: 20px; }
    .timeline-item p { font-size: 15px; line-height: 1.8; }

    .principles { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 22px; }
    .principles span { padding: 9px 13px; border: 1px solid var(--line); border-radius: 999px; background: rgba(255,255,255,.45); font-size: 13px; font-weight: 730; }

    @media (max-width: 900px) {
      .about-hero, .about-grid { grid-template-columns: 1fr; }
      .about-grid { gap: 52px; margin: 72px 0; }
      .about-aside { position: static; }
    }

    @media (max-width: 600px) {
      .about-copy { min-height: 520px; padding: 28px 24px; }
      .quote-card img { min-height: 300px; }
      .timeline-item { grid-template-columns: 1fr; gap: 6px; }
    }
  </style>

  <section class="about-hero">
    <article class="panel about-copy">
      <div>
        <span class="eyebrow">About me</span>
        <h1>你好，<br />我是 <em>{site.nickname}</em>。</h1>
        <p class="lead">我是一名前端学习者，也在学习如何观察、组织和表达。这个网站不是完成品，而是我不断成长的现场。</p>
      </div>
      <div class="about-sign">Learning in public · Building with care</div>
    </article>

    <aside class="panel quote-card">
      <img src={portrait} alt="花枝与手写文字：我也只能不停地走下去" />
      <div class="quote-meta">
        <strong>“去做，答案才会出现。”</strong>
        <span>给正在路上的自己</span>
      </div>
    </aside>
  </section>

  <section class="about-grid">
    <aside class="about-aside">
      <span class="eyebrow">Profile</span>
      <h2>一个正在形成中的创作者。</h2>
      <p>不急着定义终点。先认真对待每一次练习，让能力、审美和表达在作品里慢慢汇合。</p>
      <div class="contact-list">
        <a href={`mailto:${site.email}`}>Email ↗</a>
        <a href={site.github} target="_blank" rel="noreferrer">GitHub ↗</a>
        <span>{site.location} · {site.status}</span>
      </div>
    </aside>

    <div class="story">
      <article class="story-block">
        <h3>我在做什么</h3>
        <p>目前，我在练习 Git、GitHub、Astro、HTML、CSS 和响应式设计。我希望自己不止能实现功能，也能理解内容层级、阅读节奏和视觉气质，让每个页面都更完整、更像一件作品。</p>
        <div class="principles">
          {site.tags.map((tag) => <span>{tag}</span>)}
        </div>
      </article>

      <article class="story-block">
        <h3>为什么建立这个博客</h3>
        <p>因为成长需要痕迹。社交平台上的内容会被时间线带走，而个人网站可以按照自己的方式沉淀。我会在这里记录学习笔记、建站过程、页面尝试，以及那些从不会到会一点的真实瞬间。</p>
      </article>

      <article class="story-block">
        <h3>我的成长路线</h3>
        <div class="timeline">
          {timeline.map((item) => (
            <div class="timeline-item">
              <span class="timeline-year">{item.year}</span>
              <div>
                <h4>{item.title}</h4>
                <p>{item.text}</p>
              </div>
            </div>
          ))}
        </div>
      </article>
    </div>
  </section>
</SiteLayout>
