---
import { site } from "../data/site";
import "../styles/journal.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description = site.intro } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const isHome = Astro.url.pathname === base || Astro.url.pathname === `${base}/`;
const isAbout = Astro.url.pathname.includes("/about");
const isPost = Astro.url.pathname.includes("/posts");
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#faf7f2" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="icon" href={`${base}favicon.ico`} sizes="any" />
    <title>{title === "首页" ? site.blogName : `${title} — ${site.blogName}`}</title>
    <meta property="og:title" content={title === "首页" ? site.blogName : `${title} — ${site.blogName}`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />

    <style is:global>
      :root {
        --paper: #f4f1e9;
        --paper-deep: #e9e4d8;
        --ink: #17231b;
        --muted: #637067;
        --forest: #244b36;
        --forest-dark: #173324;
        --lime: #d9f06b;
        --orange: #e7783e;
        --line: rgba(23, 35, 27, 0.16);
        --white: #fffefa;
        --radius: 28px;
        --shadow: 0 24px 70px rgba(34, 54, 41, 0.12);
      }

      * { box-sizing: border-box; }

      html {
        scroll-behavior: smooth;
        background: var(--paper);
      }

      body {
        margin: 0;
        min-width: 320px;
        color: var(--ink);
        background:
          radial-gradient(circle at 8% 4%, rgba(217, 240, 107, 0.28), transparent 22rem),
          linear-gradient(180deg, #f9f7f1 0%, var(--paper) 38%, #eeeae0 100%);
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
          "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif;
        font-size: 16px;
        line-height: 1.6;
        text-rendering: optimizeLegibility;
        -webkit-font-smoothing: antialiased;
      }

      ::selection { color: var(--white); background: var(--forest); }
      a { color: inherit; text-decoration: none; }
      img { max-width: 100%; }
      button, a { -webkit-tap-highlight-color: transparent; }

      :focus-visible {
        outline: 3px solid var(--orange);
        outline-offset: 4px;
      }

      .skip-link {
        position: fixed;
        top: 12px;
        left: 12px;
        z-index: 100;
        padding: 10px 14px;
        color: white;
        background: var(--forest-dark);
        border-radius: 10px;
        transform: translateY(-160%);
        transition: transform 0.2s ease;
      }

      .skip-link:focus { transform: translateY(0); }

      .page-shell {
        width: min(1180px, calc(100% - 40px));
        margin: 0 auto;
      }

      .site-header {
        position: sticky;
        top: 0;
        z-index: 50;
        padding: 18px 0 10px;
      }

      .nav-shell {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        min-height: 64px;
        padding: 10px 12px 10px 16px;
        border: 1px solid rgba(255, 255, 255, 0.68);
        border-radius: 20px;
        background: rgba(249, 247, 241, 0.78);
        box-shadow: 0 12px 38px rgba(34, 54, 41, 0.08);
        backdrop-filter: blur(18px);
      }

      .brand {
        display: inline-flex;
        align-items: center;
        gap: 11px;
        font-weight: 850;
        letter-spacing: -0.02em;
      }

      .brand-mark {
        display: grid;
        width: 38px;
        height: 38px;
        place-items: center;
        color: var(--white);
        border-radius: 12px;
        background: var(--forest-dark);
        font-family: Georgia, "Times New Roman", serif;
        font-size: 21px;
        font-style: italic;
        box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.12);
      }

      .brand-sub {
        display: block;
        color: var(--muted);
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      .nav { display: flex; align-items: center; gap: 4px; }

      .nav a {
        padding: 9px 13px;
        color: var(--muted);
        border-radius: 12px;
        font-size: 14px;
        font-weight: 720;
        transition: color 0.2s ease, background 0.2s ease;
      }

      .nav a:hover,
      .nav a[aria-current="page"] {
        color: var(--ink);
        background: rgba(36, 75, 54, 0.08);
      }

      .nav .nav-github {
        margin-left: 6px;
        color: var(--white);
        background: var(--forest-dark);
      }

      .nav .nav-github:hover { color: var(--white); background: var(--forest); }
      main { padding: 22px 0 24px; }

      .panel {
        position: relative;
        overflow: hidden;
        border: 1px solid var(--line);
        border-radius: var(--radius);
        background: rgba(255, 254, 250, 0.72);
        box-shadow: var(--shadow);
      }

      .pill,
      .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        color: var(--forest);
        font-size: 12px;
        font-weight: 850;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      .pill::before,
      .eyebrow::before {
        width: 7px;
        height: 7px;
        content: "";
        border-radius: 50%;
        background: var(--orange);
        box-shadow: 0 0 0 5px rgba(231, 120, 62, 0.12);
      }

      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        min-height: 48px;
        padding: 12px 18px;
        border: 1px solid transparent;
        border-radius: 14px;
        font-size: 14px;
        font-weight: 800;
        transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
      }

      .btn:hover { transform: translateY(-2px); }

      .btn-primary {
        color: var(--white);
        background: var(--forest-dark);
        box-shadow: 0 12px 30px rgba(23, 51, 36, 0.2);
      }

      .btn-primary:hover {
        background: var(--forest);
        box-shadow: 0 16px 36px rgba(23, 51, 36, 0.25);
      }

      .btn-secondary,
      .btn-cyan {
        color: var(--ink);
        border-color: var(--line);
        background: rgba(255, 254, 250, 0.65);
      }

      .btn-secondary:hover,
      .btn-cyan:hover { background: var(--white); }

      .chip-list { display: flex; flex-wrap: wrap; gap: 8px; }

      .chip {
        padding: 7px 11px;
        color: var(--forest-dark);
        border: 1px solid var(--line);
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.52);
        font-size: 12px;
        font-weight: 720;
      }

      .section-title {
        margin: 0;
        font-size: clamp(30px, 4vw, 48px);
        line-height: 1.08;
        letter-spacing: -0.05em;
      }

      .footer {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        gap: 20px;
        margin-top: 62px;
        padding: 26px 0 34px;
        color: var(--muted);
        border-top: 1px solid var(--line);
        font-size: 13px;
      }

      .footer-mark {
        display: grid;
        width: 42px;
        height: 42px;
        place-items: center;
        color: var(--white);
        border-radius: 50%;
        background: var(--forest-dark);
        font-family: Georgia, serif;
        font-size: 20px;
        font-style: italic;
      }

      .footer-links { display: flex; justify-content: flex-end; gap: 16px; font-weight: 720; }
      .footer-links a:hover { color: var(--forest-dark); }

      @media (max-width: 720px) {
        .page-shell { width: min(100% - 24px, 1180px); }
        .site-header { padding-top: 10px; }
        .nav-shell { min-height: 58px; padding: 8px 9px 8px 12px; border-radius: 17px; }
        .brand-sub, .nav a:first-child { display: none; }
        .nav { gap: 1px; }
        .nav a { padding: 8px 9px; font-size: 12px; }
        .nav .nav-github { margin-left: 0; padding: 9px 12px; }
        main { padding-top: 10px; }
        .footer { grid-template-columns: auto 1fr; }
        .footer-links { display: none; }
      }

      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        *, *::before, *::after {
          scroll-behavior: auto !important;
          transition-duration: 0.01ms !important;
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
        }
      }
    </style>
  </head>

  <body>
    <a class="skip-link" href="#main-content">跳到主要内容</a>

    <header class="site-header page-shell">
      <div class="nav-shell">
        <a class="brand" href={base} aria-label={`${site.blogName} 首页`}>
          <span class="brand-mark" aria-hidden="true">l.</span>
          <span>
            <span>{site.blogName}</span>
            <span class="brand-sub">Letters & little things</span>
          </span>
        </a>

        <nav class="nav" aria-label="主导航">
          <a href={base} aria-current={isHome ? "page" : undefined}>首页</a>
          <a href={`${base}about/`} aria-current={isAbout ? "page" : undefined}>关于</a>
          <a href={`${base}posts/first-post/`} aria-current={isPost ? "page" : undefined}>文章</a>
          <a class="nav-github" href={site.github} target="_blank" rel="noreferrer">GitHub ↗</a>
        </nav>
      </div>
    </header>

    <main id="main-content" class="page-shell">
      <slot />
    </main>

    <footer class="footer page-shell">
      <span>© {new Date().getFullYear()} {site.nickname} · 花有花期，人有自己的节奏</span>
      <span class="footer-mark" aria-hidden="true">l.</span>
      <span class="footer-links">
        <a href={`mailto:${site.email}`}>Email</a>
        <a href={site.github} target="_blank" rel="noreferrer">GitHub</a>
      </span>
    </footer>
  </body>
</html>
