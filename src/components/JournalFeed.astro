---
interface Props { compact?: boolean }
const {compact = false} = Astro.props;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
---
<section class:list={['journal-feed', { 'feed-home': compact }]} data-feed data-base={base} data-compact={String(compact)}>
  {!compact && <div class="journal-tools"><label for="journal-search" class="sr-only">搜索手记</label><input id="journal-search" type="search" placeholder="搜索标题、正文或标签" /><label for="journal-tag" class="sr-only">标签筛选</label><select id="journal-tag"><option value="">所有标签</option></select><button id="favorites-only" class="quiet" aria-pressed="false">只看本机收藏</button></div>}
  <p class="feed-status muted" role="status">正在翻开手记…</p>
  <div class="journal-grid"></div>
  {compact && <a class="subtle-link" href={`${base}journal/`}>浏览全部手记 ↗</a>}
</section>
<dialog id="entry-dialog" class="reading-dialog"><button class="dialog-close" autofocus>关闭 ×</button><div id="entry-content"></div></dialog>
<dialog id="photo-dialog" class="lightbox"><button class="dialog-close" autofocus>关闭图片 ×</button><img alt="" /><p></p></dialog>
<style>.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)}</style>
<script>import '../scripts/feed';</script>
