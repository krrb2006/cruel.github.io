---
const home = Astro.url.pathname.replace(/\/$/, '') === import.meta.env.BASE_URL.replace(/\/$/, '');
---
{home && <aside class="little-note"><p class="small-label">A LITTLE NOTE FOR TODAY</p><p id="little-note-text">不必急着盛开，先把根扎进自己的生活。</p><div class="inline-controls"><button id="note-shuffle" class="quiet">再收一枚句子</button><button id="note-copy" class="quiet">复制珍藏</button></div><p id="note-status" role="status"></p></aside>}
<div class="reading-progress" aria-hidden="true"></div>
<div class="petal-layer" aria-hidden="true" hidden></div>
<div class="ambient-controls"><button id="petal-toggle" aria-pressed="false">花瓣：关闭</button></div>
<button id="back-top" class="back-top" aria-label="回到页面顶部" hidden>↑ 回到页首</button>
<script>
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
  const note = document.getElementById('little-note-text');
  if (note) {
    const sentences = ['不必急着盛开，先把根扎进自己的生活。','给平凡的今天，留一个温柔的注脚。','有些答案，会在认真生活的路上出现。','允许自己缓慢，也允许自己充满期待。','把一个小小的想法做出来，就是新的开始。','日子不必耀眼，也值得被认真收藏。'];
    let index = new Date().getDate() % sentences.length; note.textContent = sentences[index];
    document.getElementById('note-shuffle')!.onclick = () => { index = (index + 1) % sentences.length; note.textContent = sentences[index]; document.getElementById('note-status')!.textContent = ''; };
    document.getElementById('note-copy')!.onclick = async () => { try { await navigator.clipboard.writeText(note.textContent || ''); document.getElementById('note-status')!.textContent = '句子已复制，送给今天的自己。'; } catch {document.getElementById('note-status')!.textContent = '复制失败，可直接选中文字复制。';} };
  }
  const progress = document.querySelector<HTMLElement>('.reading-progress')!;
  const back = document.getElementById('back-top')!;
  let queued = false;
  const update = () => { const height = document.documentElement.scrollHeight - innerHeight; progress.style.transform = 'scaleX(' + (height > 0 ? Math.min(1,scrollY / height) : 0) + ')'; back.hidden = scrollY < 600; queued = false; };
  window.addEventListener('scroll', () => { if (!queued) { queued = true; requestAnimationFrame(update); } }, {passive:true});
  window.addEventListener('resize',update); update();
  back.onclick = () => window.scrollTo({top:0,behavior:reduced.matches ? 'instant' : 'smooth'});
  const button = document.getElementById('petal-toggle')!;
  const layer = document.querySelector<HTMLElement>('.petal-layer')!;
  let enabled = false;
  function petals(value: boolean) {
    enabled = value && !reduced.matches; layer.replaceChildren(); layer.hidden = !enabled;
    button.textContent = reduced.matches ? '已尊重减少动态效果设置' : '花瓣：' + (enabled ? '开启' : '关闭');
    button.setAttribute('aria-pressed',String(enabled));
    if (enabled) for (let i=0;i<9;i++) { const petal = document.createElement('span'); petal.className = 'petal'; petal.style.left = (i*12) + '%'; petal.style.animationDelay = (-i*2) + 's'; petal.style.animationDuration = (17+i) + 's'; layer.append(petal); }
  }
  try { enabled = localStorage.getItem('flower-petals') === 'on'; } catch {}
  petals(enabled);
  button.onclick = () => { petals(!enabled); try {localStorage.setItem('flower-petals',enabled ? 'on' : 'off');}catch{} };
  reduced.addEventListener('change', () => petals(enabled));
  if (!reduced.matches && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(items => { for (const item of items) if (item.isIntersecting) { item.target.classList.add('revealed'); observer.unobserve(item.target); } }, {threshold:.06});
    document.querySelectorAll('.letter,.margins,.closing').forEach(node => { node.classList.add('reveal-ready'); observer.observe(node); });
  }
</script>
